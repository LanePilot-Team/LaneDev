# 複製為 .env.local 後填入各服務的憑證。
# .env.local 已被 .gitignore 排除，不會部署到 GitHub Pages。

# TDX 會員中心 API 憑證（資料更新腳本使用）。
TDX_CLIENT_ID=your-client-id
TDX_CLIENT_SECRET=your-client-secret

# Google Places UI Kit／Maps JavaScript API 瀏覽器金鑰。
# 此金鑰會出現在前端，必須在 Google Cloud 設定網站來源與 API 限制。
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
