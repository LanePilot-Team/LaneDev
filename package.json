{
  "name": "lanedev",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "npm run lane-guidance:data",
    "dev": "vite",
    "test:lane-preview": "node --test src/nav/lanePreview.test.mjs",
    "test:lane-guidance": "node --test scripts/build_lane_guidance.test.mjs src/core/laneGuidance.test.mjs",
    "test:merge-migration": "node --test scripts/merge_migration.test.mjs",
    "test:editor-merge": "node --test src/core/editorMerge.test.mjs",
    "test:one-side-entry": "node --test src/core/oneSideEntry.test.mjs",
    "test:merged-junctions": "node --test src/core/mergedJunctions.test.mjs",
    "test:road-merge-rendering": "node scripts/run_offline.mjs scripts/road_merge_rendering.test.ts",
    "test:road-merge": "node --test src/core/roadMerge.test.mjs src/core/roadMergeReload.test.mjs src/core/graph.test.mjs src/core/graphRouteState.test.mjs src/core/graphRoadMergeBarrier.test.mjs scripts/road_merge_recovery.test.mjs scripts/vite_road_database_watch.test.mjs && npm run test:road-merge-rendering",
    "test:segment-dedupe": "node --test scripts/segment_dedupe.test.mjs",
    "audit:journal-merge": "node scripts/run_offline.mjs scripts/journal_merge_audit.ts",
    "audit:one-side-entry": "node scripts/run_offline.mjs scripts/one_side_entry_audit.ts",
    "audit:orphans": "node scripts/run_offline.mjs scripts/orphan_audit.ts",
    "audit:severed-routes": "node scripts/run_offline.mjs scripts/severed_route_audit.ts",
    "audit:merged-render": "node scripts/run_offline.mjs scripts/merged_junction_render_audit.ts",
    "audit:road-merge-recovery": "node scripts/run_offline.mjs scripts/road_merge_recovery_cli.ts",
    "audit:coverage": "node scripts/coverage_audit.mjs",
    "prebuild": "npm run lane-guidance:data",
    "build": "tsc -b && vite build",
    "collect-environment": "node scripts/collect-nanzih-environment-data.mjs",
    "preview": "vite preview",
    "lane-guidance:data": "node scripts/build_lane_guidance.mjs",
    "fetch-data": "python scripts/fetch_nanzi.py",
    "test:all": "npm run test:lane-preview && npm run test:lane-guidance && npm run test:merge-migration && npm run test:editor-merge && npm run test:one-side-entry && npm run test:merged-junctions && npm run test:segment-dedupe && npm run test:road-merge",
    "build:candidate": "node scripts/build_static_road_database.mjs"
  },
  "dependencies": {
    "@turf/turf": "^7.3.5",
    "maplibre-gl": "^5.24.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
